{
  "name": "unikraft-videos",
  "version": "0.1.0",
  "private": true,
  "description": "Unikraft Cloud video kit: brand design system, pacing presets, recipes and procedural soundtrack for Remotion videos",
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "new-video": "node scripts/new-video.ts",
    "check": "node scripts/check.ts",
    "soundtrack": "node kit/audio/generate.ts",
    "review": "node scripts/review.ts",
    "render": "node scripts/render.ts",
    "icons": "node scripts/extract-icons.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint kit videos scripts && tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/media": "4.0.529",
    "@remotion/motion-blur": "4.0.529",
    "@remotion/noise": "4.0.529",
    "@remotion/paths": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/solar": "1.2.12",
    "@remotion/eslint-config-flat": "4.0.529",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
